// 经验基线规则（先天）：tag_set 标签命中 / expr 表达式树 / steps 阶梯
{
  "scene": "travel",
  "version": 1,
  "confidence": 0.65,
  "neutral_confidence": 0.35,
  "rules": [
    {
      "dimension": "interest",
      "kind": "tag_set",
      "slot": "interest",
      "table": {
        "自然": [
          "山水",
          "公园",
          "海",
          "湖",
          "森林"
        ],
        "人文": [
          "博物馆",
          "古迹",
          "古镇",
          "寺庙"
        ],
        "亲子": [
          "乐园",
          "动物园",
          "科技馆"
        ]
      },
      "hit": {
        "score": 0.9,
        "basis": "兴趣命中"
      },
      "miss": {
        "score": 0.3,
        "basis": "兴趣不匹配"
      },
      "on_missing_slot": {
        "score": 0.5
      }
    },
    {
      "dimension": "distance",
      "kind": "expr",
      "expr": {
        "kind": "linear",
        "field": "distance_m",
        "default": 5000,
        "far": 20000
      }
    },
    {
      "dimension": "cost",
      "kind": "steps",
      "field": "price_per_person",
      "default": 100,
      "steps": [
        {
          "le": 50,
          "score": 0.9
        },
        {
          "le": 120,
          "score": 0.7
        },
        {
          "le": 250,
          "score": 0.5
        }
      ],
      "otherwise": 0.2
    },
    {
      "dimension": "weather_fit",
      "kind": "expr",
      "expr": {
        "kind": "cond",
        "field": "weather",
        "in": [
          "小雨",
          "大雨",
          "暴雨",
          "雪"
        ],
        "then": {
          "kind": "linear",
          "field": "distance_m",
          "default": 5000,
          "far": 15000
        },
        "else": {
          "kind": "blend",
          "base": 0.5,
          "weight": 0.5,
          "inner": {
            "kind": "linear",
            "field": "distance_m",
            "default": 5000,
            "far": 15000
          }
        }
      }
    },
    {
      "dimension": "crowd",
      "kind": "expr",
      "expr": {
        "kind": "linear",
        "field": "crowd_index",
        "default": 50,
        "far": 100
      }
    }
  ]
}
