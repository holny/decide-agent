{
  "dimensions": {
    "fit": {
      "display": "需求匹配",
      "weight": 0.3,
      "description": "与你的用途/需求的契合程度"
    },
    "price": {
      "display": "价格成本",
      "weight": 0.3,
      "description": "购买价格与长期使用成本，越划算越好"
    },
    "quality": {
      "display": "品质口碑",
      "weight": 0.25,
      "description": "质量、耐用性与口碑评价"
    },
    "service": {
      "display": "获取售后",
      "weight": 0.15,
      "description": "购买渠道便利性与保修售后"
    }
  }
}
