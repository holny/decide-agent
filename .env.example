# Decide-Agent 环境变量模板（复制为 .env 填写；.env 已 gitignore，永不提交）
#
# 密钥一律经配置的 api_key_env 名引用（见 config.yaml decision_model/llm 段）。
# 以下为示例名，可自定义——配置里写同名即可。

# 判断模型层（decision_model.api_key_env 指向的变量名）
DECISION_MODEL_API_KEY=

# 判断②级兜底 LLM（llm.api_key_env 指向的变量名）
LLM_API_KEY=

# 地图/POI 数据源（config.jsonc tools.vendor.*.key_env 指向的变量名；缺省 = 该源不可用）
# region=cn 默认链：高德 MCP → 百度 REST；region=global：Google → Foursquare
# OSM Overpass 免 key：providers 显式加 "osm" 启用
AMAP_KEY=
BAIDU_MAP_KEY=
GOOGLE_MAPS_KEY=
FOURSQUARE_KEY=
